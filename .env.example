DATABASE_URL=postgres://whoxos:whoxos@localhost:5432/whoxos
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=whoxos-dev-secret
WHOXOS_TOOL_ACTION_SIGNING_SECRET=whoxos-dev-tool-action-signing-secret-change-me

# Optional WHOXOS ID Gmail OAuth broker. Enroll the instance first; keep both
# private keys in the deployment secret manager. HTTP base URLs must be loopback.
# WHOXOS_ID_CONNECTOR_BASE_URL=http://localhost:3000
# WHOXOS_ID_CONNECTOR_ENVIRONMENT=development
# WHOXOS_ID_CONNECTOR_INSTANCE_ID=inst_example
# WHOXOS_ID_CONNECTOR_SIGN_PRIVATE_KEY=
# WHOXOS_ID_CONNECTOR_SEAL_PRIVATE_KEY=

# Process-wide protection for expensive full-tree workspace Git scans.
# WHOXOS_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# WHOXOS_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# WHOXOS_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# WHOXOS_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# HTTP adapters may call public HTTP(S) origins by default. Opt trusted private
# origins in explicitly; entries are exact origins (scheme, host, and port).
# WHOXOS_HTTP_ADAPTER_PRIVATE_ENDPOINT_ALLOWLIST=http://hooks.internal.example:8080

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
