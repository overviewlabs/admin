    "@whoxos/adapter-utils": "workspace:*",
    "@whoxos/hermes-whoxos-adapter": "workspace:*",
    "@whoxos/shared": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.0",
    "lexical": "0.48.0",
    "lucide-react": "^1.38.0",
    "mermaid": "^11.17.2",
    "motion": "^13.1.1",
    "onnxruntime-web": "1.22.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
