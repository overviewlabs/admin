[Unit]
Description=WHOXOS bounded service diagnostics metadata
After=systemd-journald.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/libexec/overview-labs-it-diagnostics.py
TimeoutStartSec=20
MemoryMax=96M
CPUQuota=25%
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/overview-labs-health
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
UMask=0022
