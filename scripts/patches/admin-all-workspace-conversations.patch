+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+from cptr.routers.chat import list_chats
+
+def chat(ident,title,workspace=None,owner='owner',**extra):
+    meta={'workspace':workspace} if workspace else {}
+    meta.update(extra)
+    return SimpleNamespace(id=ident,title=title,user_id=owner,meta=meta,summary=None,current_message_id=None,created_at=1,updated_at=10,last_read_at=10)
+
+class Conversations(unittest.IsolatedAsyncioTestCase):
+    async def global_list(self,items,**options):
+        with patch('cptr.routers.chat._get_user',return_value='owner'), \
+             patch('cptr.routers.chat.Chat.get_by_user',AsyncMock(return_value=items)) as load, \
+             patch('cptr.routers.chat.Workspace.get_by_user',AsyncMock(return_value=[SimpleNamespace(path='/projects/studio',name='OVL Studio')])) as workspaces, \
+             patch('cptr.routers.chat.chat_directory',side_effect=AssertionError('Global list must not scan files')), \
+             patch('cptr.utils.chat_task.get_active_chat_ids',return_value=set()):
+            result=await list_chats(None,workspace=None,limit=options.get('limit',30),offset=options.get('offset',0),sort_by='title',sort_dir='asc',all_workspaces=True,q=options.get('q',''))
+            load.assert_awaited_once_with('owner');workspaces.assert_awaited_once_with('owner')
+            return result
+
+    async def test_all_workspaces_and_home_are_combined_and_named(self):
+        result=await self.global_list([chat('h','General'),chat('s','Build','/projects/studio'),chat('x','Host','/projects/System/')])
+        self.assertEqual(result['total'],3)
+        by_id={c['id']:c for c in result['chats']}
+        self.assertIsNone(by_id['h']['workspace_name'])
+        self.assertEqual(by_id['s']['workspace_name'],'OVL Studio')
+        self.assertEqual(by_id['x']['workspace_name'],'System')
+        self.assertEqual(by_id['s']['meta']['workspace'],'/projects/studio')
+
+    async def test_other_users_and_internal_runs_are_excluded(self):
+        result=await self.global_list([chat('ok','Public'),chat('hidden','Hidden',internal=True),chat('sub','Subagent',subagent=True),chat('foreign','Private',owner='someone-else')])
+        self.assertEqual([c['id'] for c in result['chats']],['ok'])
+
+    async def test_search_matches_workspace_before_pagination(self):
+        result=await self.global_list([chat('h','General'),chat('s','Build','/projects/studio'),chat('s2','Deploy','/projects/studio')],q='ovl studio',limit=1,offset=1)
+        self.assertEqual(result['total'],2);self.assertFalse(result['has_more']);self.assertEqual(result['chats'][0]['id'],'s2')
+        first=await self.global_list([chat('s','Build','/projects/studio'),chat('s2','Deploy','/projects/studio')],limit=1)
+        self.assertTrue(first['has_more'])
+
+    async def test_scoped_workspace_listing_keeps_its_portable_folder_behavior(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);(root/'folder').mkdir();(root/'folder'/'s.json').write_text('{}')
+            with patch('cptr.routers.chat._get_user',return_value='owner'),patch('cptr.routers.chat.chat_directory',return_value=root),patch('cptr.routers.chat.Chat.get_by_ids',AsyncMock(return_value=[chat('s','Build','/projects/studio')])) as load,patch('cptr.utils.chat_task.get_active_chat_ids',return_value=set()):
+                result=await list_chats(None,workspace='/projects/studio',limit=30,offset=0,sort_by='title',sort_dir='asc',all_workspaces=False,q='')
+                self.assertEqual(result['chats'][0]['folder'],'folder');load.assert_awaited_once_with(['s'])
+if __name__=='__main__':unittest.main()
