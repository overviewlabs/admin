+import os
+import tempfile
+import unittest
+from pathlib import Path
+from cptr.utils.agents.artifacts import linked_artifacts
+from cptr.utils.agents.codex import _tool_from_item_event
+
+class ArtifactLinks(unittest.TestCase):
+    def test_directories_and_special_files_are_not_attachments(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            (root / 'project').mkdir()
+            (root / 'alias').symlink_to(root / 'project', target_is_directory=True)
+            os.mkfifo(root / 'pipe')
+            text = ' '.join(f'[{name}](./{name})' for name in ['project', 'alias', 'pipe'])
+            self.assertEqual(linked_artifacts(text, tmp, 'message'), [])
+
+    def test_real_files_and_missing_deliverables_keep_delivery_behavior(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            (Path(tmp) / 'report.txt').write_text('report')
+            events = linked_artifacts('[Report](./report.txt) [Again](./report.txt) [Missing](./missing.txt)', tmp, 'm')
+            self.assertEqual([e.name for e in events], ['report.txt', 'missing.txt'])
+
+    def test_source_navigation_and_web_links_are_not_attachments(self):
+        self.assertEqual(linked_artifacts('[Source](/tmp/app.py:12) [Web](https://example.com)', '/tmp', 'm'), [])
+
+class ToolResults(unittest.TestCase):
+    def event(self, **kwargs):
+        return _tool_from_item_event('item/completed', {'item': {'type':'commandExecution', 'id':'c', 'command':'pwd', 'status':'completed', **kwargs}})
+
+    def test_command_completion_without_delta_keeps_result(self):
+        event = self.event(aggregatedOutput='/root\n', exitCode=0)
+        self.assertEqual(event.output, '/root\n')
+        self.assertEqual(event.status, 'completed')
+
+    def test_empty_result_is_still_a_result(self):
+        self.assertEqual(self.event(aggregatedOutput='', exitCode=0).output, '')
+
+    def test_failure_retains_output_and_failed_status(self):
+        event = self.event(aggregatedOutput='command failed', exitCode=1)
+        self.assertEqual(event.status, 'failed')
+        self.assertEqual(event.output, 'command failed')
+
+    def test_mcp_result_and_error_are_saved(self):
+        for item in [{'result': {'content': [{'type':'text', 'text':'done'}]}}, {'error': {'message':'unavailable'}}]:
+            event = _tool_from_item_event('item/completed', {'item': {'type':'mcpToolCall','id':'m','server':'test','tool':'read','status':'completed',**item}})
+            self.assertTrue(event.output)
+            self.assertEqual(event.status, 'failed' if 'error' in item else 'completed')
+
+    def test_start_does_not_publish_incomplete_output(self):
+        event = _tool_from_item_event('item/started', {'item': {'type':'commandExecution','id':'c','command':'pwd','aggregatedOutput':'partial'}})
+        self.assertIsNone(event.output)
+        self.assertEqual(event.status, 'in_progress')
+
+if __name__ == '__main__': unittest.main()
