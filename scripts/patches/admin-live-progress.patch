--- /dev/null
+++ b/tests/test_codex_progress.py
@@ -0,0 +1,36 @@
+import asyncio
+import unittest
+from unittest.mock import AsyncMock, patch
+from cptr.utils.agents.codex import CodexAppServer, _runtime_status_from_event
+from cptr.utils.agents.events import AgentStatusUpdate
+
+class RuntimeProgress(unittest.TestCase):
+    def test_compaction_has_start_and_completion_without_exposing_history(self):
+        for method, completed in [('item/started',False),('item/completed',True)]:
+            event=_runtime_status_from_event(method,{'item':{'type':'contextCompaction','id':'c','private':'secret'}})
+            self.assertEqual(event,AgentStatusUpdate('codex-context','Preparing conversation history',completed))
+        self.assertTrue(_runtime_status_from_event('thread/compacted',{}).completed)
+    def test_unrelated_items_are_not_invented_progress(self):
+        self.assertIsNone(_runtime_status_from_event('item/started',{'item':{'type':'agentMessage','id':'m'}}))
+        self.assertIsNone(_runtime_status_from_event('turn/completed',{}))
+
+class ControlTimeout(unittest.IsolatedAsyncioTestCase):
+    async def test_timeout_cleans_pending_rpc_without_replaying_it(self):
+        client=CodexAppServer('codex','/tmp',{})
+        client._send=AsyncMock()
+        async def expire(future,timeout):
+            future.cancel()
+            raise asyncio.TimeoutError()
+        with patch('cptr.utils.agents.codex.asyncio.wait_for',side_effect=expire):
+            with self.assertRaisesRegex(RuntimeError,'within 60 seconds'):
+                await client.request('thread/resume',{'threadId':'thread'})
+        self.assertEqual(client.pending,{})
+        self.assertEqual(client._send.await_count,1)
+    async def test_response_is_routed_normally(self):
+        client=CodexAppServer('codex','/tmp',{})
+        async def send(payload):
+            await client._route_message({'id':payload['id'],'result':{'ok':True}})
+        client._send=send
+        self.assertEqual(await client.request('initialize',{}),{'id':1,'result':{'ok':True}})
+        self.assertEqual(client.pending,{})
+if __name__=='__main__':unittest.main()
