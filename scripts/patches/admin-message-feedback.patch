+import unittest
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+from fastapi import HTTPException
+from pydantic import ValidationError
+from cptr.routers.chat import MessageFeedbackRequest, save_message_feedback
+
+class Feedback(unittest.IsolatedAsyncioTestCase):
+    async def invoke(self, owner='owner', message_chat='chat', role='assistant', done=True):
+        with patch('cptr.routers.chat._get_user', return_value='owner'), patch('cptr.routers.chat.Chat.get_by_id', AsyncMock(return_value=SimpleNamespace(user_id=owner))), patch('cptr.routers.chat.ChatMessage.get_by_id', AsyncMock(return_value=SimpleNamespace(chat_id=message_chat, role=role, done=done, meta={'keep':True}))), patch('cptr.routers.chat.ChatMessage.update', AsyncMock()) as update, patch('cptr.utils.chat_export.export_chat_to_file', AsyncMock()) as export:
+            result=await save_message_feedback('chat','message',MessageFeedbackRequest(vote='down',reason='Needs detail'),None)
+            self.assertTrue(update.call_args.kwargs['meta']['keep'])
+            self.assertEqual(update.call_args.kwargs['meta']['feedback']['reason'],'Needs detail')
+            export.assert_awaited_once_with('chat')
+            return result
+    async def test_feedback_persists_and_exports_without_replacing_metadata(self):
+        self.assertEqual((await self.invoke())['feedback']['vote'],'down')
+    async def test_other_owner_is_rejected(self):
+        with self.assertRaises(HTTPException) as error: await self.invoke(owner='other')
+        self.assertEqual(error.exception.status_code,404)
+    async def test_cross_chat_message_is_rejected(self):
+        with self.assertRaises(HTTPException) as error: await self.invoke(message_chat='other')
+        self.assertEqual(error.exception.status_code,404)
+    async def test_user_message_is_rejected(self):
+        with self.assertRaises(HTTPException): await self.invoke(role='user')
+    async def test_unfinished_reply_is_rejected(self):
+        with self.assertRaises(HTTPException) as error: await self.invoke(done=False)
+        self.assertEqual(error.exception.status_code,409)
+    def test_invalid_vote_and_oversized_reason_are_rejected(self):
+        for body in [{'vote':'unknown'},{'vote':'down','reason':'x'*4001}]:
+            with self.assertRaises(ValidationError): MessageFeedbackRequest(**body)
+
+if __name__=='__main__': unittest.main()
