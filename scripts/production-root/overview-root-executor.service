[Unit]
Description=WHOXOS production root command executor
After=network.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=overview-root-executor
RuntimeDirectoryMode=0755
StateDirectory=overview-root-executor
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/libexec/overview-root-executor/executor.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/overview-root-executor /run/overview-root-executor
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
