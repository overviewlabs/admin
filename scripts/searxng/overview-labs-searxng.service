[Unit]
Description=WHOXOS private SearXNG search backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=searxng
Group=searxng
WorkingDirectory=/opt/overview-labs/searxng/src
Environment=SEARXNG_SETTINGS_PATH=/etc/overview-labs-searxng/settings.yml
Environment=PYTHONPATH=/opt/overview-labs/searxng
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=XDG_CACHE_HOME=/var/cache/overview-labs-searxng
ExecStart=/opt/overview-labs/searxng/venv/bin/granian --interface wsgi --host 127.0.0.1 --port 8888 --workers 1 --blocking-threads 4 --backpressure 16 --no-ws --no-access-log --log-level warning overview_searxng:application
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
KillSignal=SIGTERM
UMask=0077
StateDirectory=overview-labs-searxng
StateDirectoryMode=0750
CacheDirectory=overview-labs-searxng
CacheDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=512M
MemoryMax=768M
CPUQuota=100%
TasksMax=256
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=overview-labs-searxng

[Install]
WantedBy=multi-user.target
